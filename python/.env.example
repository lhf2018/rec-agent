# Copy to .env when using a real model. MVP defaults to mock LLM.
# Prefer external files outside the repo (never commit keys):
#   G:\llm apikey.txt
#   G:\llm.config.txt   (base_url=... / model=...)
REC_AGENT_USE_MOCK_LLM=true
REC_AGENT_LLM_API_KEY=
REC_AGENT_LLM_API_KEY_FILE=G:\llm apikey.txt
REC_AGENT_LLM_CONFIG_FILE=G:\llm.config.txt
# OpenAI-compatible base, e.g. https://api.openai.com/v1 or your gateway /v1
REC_AGENT_LLM_BASE_URL=
REC_AGENT_LLM_MODEL=mock
REC_AGENT_LLM_TIMEOUT_S=30
REC_AGENT_LLM_TEMPERATURE=0
REC_AGENT_TASK_TIMEOUT_MS=20000
REC_AGENT_ENABLE_REACT=true
REC_AGENT_ENABLE_LLM=true
REC_AGENT_REACT_MAX_STEPS=6
REC_AGENT_MAX_SUBMIT_FAILURES=2
# Optional: reject submit when self_score < threshold (counts toward arbitration)
# REC_AGENT_DISPLAY_CONFIDENCE_THRESHOLD=0.55
# Optional: suppress when heuristic opportunity score is below floor
# REC_AGENT_OPPORTUNITY_MIN_SCORE=0.45
# Product-intent defaults (local MVP uses 0 cooldown):
# REC_AGENT_COOLDOWN_MINUTES=30
# REC_AGENT_SIMILAR_SUPPRESS_MINUTES=120
# REC_AGENT_FREQ_CAP_PER_DAY=10
